{
  "name": "run-hex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "AEX Run migrated to hexagonal architecture (Ports & Adapters + DDD bounded contexts).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @aex/api & npm run dev -w @aex/web",
    "dev:api": "npm run dev -w @aex/api",
    "dev:web": "npm run dev -w @aex/web",
    "typecheck": "npm run typecheck -w @aex/api",
    "depcruise": "npm run depcruise -w @aex/api",
    "verify": "npm run verify -w @aex/api",
    "demo": "npm run demo -w @aex/api"
  }
}
