# Serves the built SPA and reverse-proxies the API on the same origin so
# better-auth cookies work. /api and /ws go to the api service over Railway's
# private network; everything else is the static SPA with history fallback.
:80 {
	encode gzip

	@backend path /api/* /ws /ws/*
	handle @backend {
		reverse_proxy {$API_UPSTREAM:api.railway.internal:3001}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
